PPX2                     = -7.11876752964969 $quadratic influence of inflation pressure on longitudinal slip stiffness         
PPX3                     = -0.18279774582078 $linear influence of inflation pressure on peak longitudinal friction         
PPX4                     = -4.86712784802162 $quadratic influence of inflation pressure on peak longitudinal friction         
RBX1                     = 2.68645195181399  $Slope factor for combined slip Fx reduction         
RBX2                     = 6.08518196663322  $Variation of slope Fx reduction with kappa         
RBX3                     = 50                $Influence of camber on stiffness for Fx combined         
RCX1                     = 3                 $Shape factor for combined slip Fx reduction         
REX1                     = -3                $Curvature factor of combined Fx         
REX2                     = 1                 $Curvature factor of combined Fx with load         
RHX1                     = -0.01             $Shift factor for combined slip Fx reduction         
$----------------------------------------------------------overturning
[OVERTURNING_COEFFICIENTS]
QSX1                     = -0.0109125416223306         $Vertical shift of overturning moment         
QSX2                     = 0.372894255712557            $Camber induced overturning couple         
