[MDI_HEADER]
FILE_TYPE                ='tir'
FILE_VERSION             =3.0
FILE_FORMAT              ='ASCII'
$----------------------------------------------------------------units
[UNITS]
LENGTH                   ='meter'
FORCE                    ='newton'
ANGLE                    ='radians'
MASS                     ='kg'
TIME                     ='second'
$----------------------------------------------------------------model
[MODEL]
FITTYP                   = 61                $Magic Formula Version number             
TYRESIDE                 ='Left'
LONGVL                   = 11.1              $Nominal speed         
VXLOW                    = 1                 $Lower boundary of slip calculation
$-----------------------------------------------------------dimensions
[DIMENSION]
UNLOADED_RADIUS          = 0.25908           $Free tyre radius         
WIDTH                    = 0.17526               $Nominal section width of the tyre         
RIM_RADIUS               = 0.1651            $Nominal rim radius
RIM_WIDTH                = 0.1778            $Rim width         
ASPECT_RATIO             = 0.536             $Nominal aspect ratio
$-------------------------------------------------operating conditions
[OPERATING_CONDITIONS]
INFLPRES                 = 82319             $Tyre inflation pressure
NOMPRES                  = 82319             $Nominal tyre inflation pressure
$--------------------------------------------------------------inertia
[INERTIA]
MASS                     = 4.5               $Tyre Mass
GRAVITY                  = 9.81             $Gravity acting on belt in Z direction
$--------------------------------------------------------------vertical
[VERTICAL]
FNOMIN                   = 800               $Nominal wheel load
$-------------------------------------------------------------structural
[STRUCTURAL]
$--------------------------------------------------------contact_patch
[CONTACT_PATCH]
$---------------------------------------------inflation_pressure_range
[INFLATION_PRESSURE_RANGE]       
PRESMIN                  = 10000             $Minimum valid tyre inflation pressure         (guess)
PRESMAX                  = 1000000           $Minimum valid tyre inflation pressure     (guess)    
$-------------------------------------------------vertical_force_range
[VERTICAL_FORCE_RANGE]        
FZMIN                    = 100               $Minimum allowed wheel load         (guess)
FZMAX                    = 8400              $Maximum allowed wheel load         (guess)
$------------------------------------------------------long_slip_range
[LONG_SLIP_RANGE]      
KPUMIN                   = -1.5              $Minimum valid wheel slip         (guess)
KPUMAX                   = 1.5               $Maximum valid wheel slip         (guess)
$-----------------------------------------------------slip_angle_range
[SLIP_ANGLE_RANGE]   
ALPMIN                   = -1.5              $Minimum valid slip angle         (guess)
ALPMAX                   = 1.5               $Maximum valid slip angle         (guess)
$-----------------------------------------------inclination_slip_range
[INCLINATION_ANGLE_RANGE]   
CAMMIN                   = -0.17453          $Minimum valid camber angle         (guess)
CAMMAX                   = 0.17453           $Maximum valid camber angle         (guess)
$--------------------------------------------------------------scaling
[SCALING_COEFFICIENTS]
LFZO                     = 1                 $Scale factor of nominal (rated) load         
LCX                      = 1                 $Scale factor of Fx shape factor         
LMUX                     = 0.6                 $Scale factor of Fx peak friction coefficient         
LEX                      = 1                 $Scale factor of Fx curvature factor         
LKX                      = 1                 $Scale factor of Fx slip stiffness         
LHX                      = 1                 $Scale factor of Fx horizontal shift         
LVX                      = 1                 $Scale factor of Fx vertical shift         
LCY                      = 1                 $Scale factor of Fy shape factor         
LMUY                     = 0.6                 $Scale factor of Fy peak friction coefficient         
LEY                      = 1                 $Scale factor of Fy curvature factor         
LKY                      = 1                 $Scale factor of Fy cornering stiffness         
LKYC                     = 1                 $Scale factor of Fy camber stiffness         
LKZC                     = 1                 $Scale factor of Mz camber stiffness         
LHY                      = 1                 $Scale factor of Fy horizontal shift         
LVY                      = 1                 $Scale factor of Fy vertical shift         
LTR                      = 1                 $Scale factor of Peak of pneumatic trail         
LRES                     = 1                 $Scale factor for offset of Mz residual torque         
LXAL                     = 1                 $Scale factor of alpha influence on Fx         
LYKA                     = 1                 $Scale factor of kappa influence on Fy         
LVYKA                    = 1                 $Scale factor of kappa induced Fy         
LS                       = 1                 $Scale factor of Moment arm of Fx         
LMX                      = 1                 $Scale factor of Mx overturning moment         
LVMX                     = 1                 $Scale factor of Mx vertical shift         
LMY                      = 1                 $Scale factor of rolling resistance torque         
LMP                      = 1                 $Scale factor of Mz parking torque         
$---------------------------------------------------------longitudinal
[LONGITUDINAL_COEFFICIENTS]
PCX1                     = 1.90237124898696  $Shape factor Cfx for longitudinal force         
PDX1                     = 2.61661131790938  $Longitudinal friction Mux at Fznom         
